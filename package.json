{
  "name": "markdown-extension",
  "version": "1.0.0",
  "description": "Browser extension to render Markdown files with Mermaid, PlantUML, and syntax highlighting",
  "main": "index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "setup": "node scripts/download-libs.js",
    "build": "node scripts/build.js",
    "build:chrome": "node scripts/build.js chrome",
    "build:edge": "node scripts/build.js edge",
    "test": "node --test",
    "test:coverage": "c8 --all --include=\"src/**/*.js\" --include=\"scripts/**/*.js\" --exclude=\"src/common/lib/**/*.js\" --reporter=text --reporter=lcov node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tlcsdm/markdown-extension.git"
  },
  "keywords": [
    "markdown",
    "mermaid",
    "plantuml",
    "browser-extension",
    "chrome",
    "edge"
  ],
  "author": "tlcsdm",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tlcsdm/markdown-extension/issues"
  },
  "homepage": "https://github.com/tlcsdm/markdown-extension#readme",
  "devDependencies": {
    "c8": "^12.0.0",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.3",
    "markdown-it-attrs": "^5.0.1",
    "markdown-it-emoji": "^3.1.0",
    "mermaid": "^12.3.0",
    "pako": "^3.0.3"
  }
}
